# Copy to .env (git-ignored) and set your own password.
# Must match Database:User / Database:Password / Database:Name in appsettings.Local.json / appsettings.json.
POSTGRES_USER=rejestr
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=rejestr
# Host port; change (e.g. 5433) when 5432 is taken, and set the same Database:Port in appsettings.Local.json.
POSTGRES_PORT=5432
