@using Blazilla
@using RejestrCzasu.Data
@using RejestrCzasu.Domain
@using Microsoft.JSInterop
@inject IJSRuntime JS
@* The one Entry form (AD-10): presentation only. It gets the model, the options of DictionaryOptions and the save
   call from its host (the /wpisy/nowy page; EntryDialog); it never creates a database context.
   Focus order follows the markup: Data → Projekt → Typ pracy → Opis → Czas (no tabindex > 0).
   Enter: in Data and Czas it saves the form without a confirmation; in a combobox it only picks the option; in Opis
   (a text area of up to TimeEntry.DescriptionMaxLength characters) it starts a new line, and Ctrl+Enter saves.
   Czas sends its current text with Enter and Opis with Ctrl+Enter (ChangeAfterKeyPress), so the save never sees a
   value the browser has not reported yet; the native date input reports every complete date as it is typed. Data saves on the
   key-up of an Enter whose key-down also happened in Data, so the Enter that opened the screen (menu button, then
   the focus in Data) never submits an empty form. The first focus in Data: in the Entry window the autofocus of the
   native dialog (AutofocusDate); on /wpisy/nowy the page calls FocusDateAsync after the form's first render, because
   FocusOnNavigate (h1) has already focused the page when the form appears and blocks autofocus. The save button is
   not a submit button: otherwise Enter in any Fluent text field would submit the form (implicit submission) before
   its text reaches the server. *@

<EditForm EditContext="_editContext" OnSubmit="SubmitAsync" class="entry-form" novalidate>
    <FluentValidator Validator="_validator" />
    <div class="entry-form-date" @onkeydown="OnDateKeyDown" @onkeyup="OnDateKeyUpAsync">
        <FluentDatePicker TValue="DateOnly?" Value="Model.Date" ValueChanged="OnDateValueChangedAsync" ValueExpression="() => Model.Date"
                          RenderStyle="DatePickerRenderStyle.Native" Label="Data" Autofocus="AutofocusDate" class="entry-date" />
        <span class="entry-day-name">@DayName</span>
    </div>
    <FluentCombobox @ref="_project" Items="Projects" @bind-Value="Model.Project" OptionText="ProjectText"
                    Label="Projekt" Placeholder="Wpisz początek kodu" class="entry-project" />
    <FluentCombobox @ref="_workType" Items="WorkTypes" @bind-Value="Model.WorkType" OptionText="WorkTypeText"
                    Label="Typ pracy" Placeholder="Wpisz początek nazwy" class="entry-work-type" />
    @* No MaxLength: the browser would cut a pasted text before the trim and the User would not see the message (AD-8). *@
    <FluentTextArea @bind-Value="Model.Description" Label="Opis" Resize="TextAreaResize.Vertical"
                    ChangeAfterKeyPress="CtrlEnterKey" OnChangeAfterKeyPress="OnEnterAsync" class="entry-description" />
    <FluentTextInput @bind-Value="Model.Czas" Label="Czas" Placeholder="np. 1h 30m" ChangeAfterKeyPress="EnterKey"
                     OnChangeAfterKeyPress="OnEnterAsync" class="entry-czas" />
    <div class="entry-form-buttons">
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SubmitAsync" class="entry-save">Zapisz</FluentButton>
        @Buttons
    </div>
</EditForm>

@code {
    private static readonly KeyPress[] EnterKey = [KeyPress.For(KeyCode.Enter)];

    /// <summary>Ctrl+Enter only (the library matches the modifiers exactly): a plain Enter in Opis starts a new line.</summary>
    private static readonly KeyPress[] CtrlEnterKey = [KeyPress.For(KeyCode.Enter).AndCtrlKey(true).WithPreventDefault(true)];

    private readonly EntryFormValidator _validator = new();
    private EditContext _editContext = default!;
    /// <summary>The field of Data: FluentDatePicker 5.0.1 has no element reference, so it is focused by its selector.</summary>
    internal const string DateFieldSelector = "form.entry-form .entry-form-date fluent-text-input";

    private FluentCombobox<ProjectOption, ProjectOption?>? _project;
    private FluentCombobox<WorkTypeOption, WorkTypeOption?>? _workType;
    private bool _saving;
    private bool _enterDownInDate;

    /// <summary>The edited Entry; the host keeps the instance (e.g. clears it after a save, R5).</summary>
    [Parameter, EditorRequired] public EntryInput Model { get; set; } = default!;

    /// <summary>Project options, only from <c>DictionaryOptions.ProjectsAsync</c> (AD-10).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ProjectOption> Projects { get; set; } = [];

    /// <summary>Work type options, only from <c>DictionaryOptions.WorkTypesAsync</c> (AD-10).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<WorkTypeOption> WorkTypes { get; set; } = [];

    /// <summary>Called with the model once it has passed <see cref="EntryFormValidator"/>; a save in progress ignores further saves.</summary>
    [Parameter, EditorRequired] public EventCallback<EntryInput> OnSave { get; set; }

    /// <summary>Called after every change of the date field (also to <c>null</c> when it is cleared).</summary>
    [Parameter] public EventCallback<DateOnly?> OnDateChanged { get; set; }

    /// <summary>Further buttons after Zapisz in the same row (the Entry window: Anuluj); none on Nowy wpis.</summary>
    [Parameter] public RenderFragment? Buttons { get; set; }

    /// <summary>
    /// Autofocus of Data (the Entry window: the native dialog focuses it when it opens). <c>false</c> on Nowy wpis,
    /// which calls <see cref="FocusDateAsync"/> itself.
    /// </summary>
    [Parameter] public bool AutofocusDate { get; set; } = true;

    /// <summary>Called when a save is asked for but the model does not pass <see cref="EntryFormValidator"/>.</summary>
    [Parameter] public EventCallback OnInvalid { get; set; }

    /// <summary>Text of a Project option: "KOD - nazwa".</summary>
    internal static string ProjectText(ProjectOption? project) => project is null ? "" : $"{project.Code} - {project.Name}";

    private static string WorkTypeText(WorkTypeOption? workType) => workType?.Name ?? "";

    private string DayName => Model.Date is { } date ? PolishCalendar.DayName(date) : "";

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_editContext?.Model, Model))
        {
            _editContext = new EditContext(Model);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A preset Project or Work type (edit and copy windows): show its text once the combobox's field exists.
        if (!firstRender || (Model.Project is null && Model.WorkType is null))
        {
            return;
        }
        // The workaround of Fluent UI 5.0.1 lives in eod.js of the eod-ui copy (AD-1, AD-23 item 9).
        if (Model.Project is not null && _project is not null)
        {
            await JS.InvokeVoidAsync("EodUI.showSelectedText", _project.Element, ProjectText(Model.Project));
        }
        if (Model.WorkType is not null && _workType is not null)
        {
            await JS.InvokeVoidAsync("EodUI.showSelectedText", _workType.Element, WorkTypeText(Model.WorkType));
        }
    }

    /// <summary>Moves the focus to the Data field (the start of the Sesja wpisywania on Nowy wpis, R16).</summary>
    public Task FocusDateAsync() =>
        // The helper of the eod-ui copy (eod.js, AD-1): the first form on the page is the one of Nowy wpis.
        JS.InvokeVoidAsync("EodUI.focusElement", DateFieldSelector).AsTask();

    /// <summary>Moves the focus to the Projekt field (after a save in the Sesja wpisywania, R5).</summary>
    public async Task FocusProjectAsync()
    {
        if (_project is not null)
        {
            await _project.Element.FocusAsync();
        }
    }

    private async Task OnDateValueChangedAsync(DateOnly? date)
    {
        Model.Date = date;
        await OnDateChanged.InvokeAsync(date);
    }

    private static bool IsPlainEnter(KeyboardEventArgs e) => e.Key == "Enter" && !e.AltKey && !e.CtrlKey && !e.ShiftKey && !e.MetaKey;

    private void OnDateKeyDown(KeyboardEventArgs e) => _enterDownInDate = IsPlainEnter(e);

    private Task OnDateKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
        {
            return Task.CompletedTask;
        }
        // Only the key-up of an Enter pressed in Data: a key-up whose key-down happened elsewhere does nothing.
        var pressedHere = _enterDownInDate && IsPlainEnter(e);
        _enterDownInDate = false;
        return pressedHere ? SubmitAsync() : Task.CompletedTask;
    }

    private Task OnEnterAsync(FluentKeyPressEventArgs e) => SubmitAsync();

    private async Task SubmitAsync()
    {
        if (_saving)
        {
            return;
        }
        if (!_editContext.Validate())
        {
            await OnInvalid.InvokeAsync();
            return;
        }
        _saving = true;
        try
        {
            await OnSave.InvokeAsync(Model);
        }
        finally
        {
            _saving = false;
        }
    }
}
