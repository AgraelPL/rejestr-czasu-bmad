@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Sections
@using RejestrCzasu.Data
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject AppearanceSettings Appearance
@inject IThemeService ThemeService
@* Layout of the application screens (AD-11): EodShell of the eod-ui copy with the top bar ("?", theme, Ustawienia
   konta, Wyloguj), the Primary Nowy wpis button and the side menu (NFR-6). Every screen declares its help topic with
   PageHelp (AD-22). AppErrorBoundary encloses the whole EodShell, because EodShell renders FluentProviders: exceptions
   of the screen and of its windows reach the same boundary (AD-17). *@

@* Default "?" (help index) for a screen without PageHelp; a PageHelp rendered later takes the section over. *@
<PageHelp />

<AppErrorBoundary>
    <EodShell>
        <HeaderActions>
            <SectionOutlet SectionName="@HelpSection" />
            <FluentButton IconStart="@(new Icons.Regular.Size20.WeatherMoon())" IconOnly="true"
                          Appearance="ButtonAppearance.Transparent" Class="eod-onbrand app-theme"
                          Title="Motyw jasny lub ciemny" aria-label="Motyw jasny lub ciemny" OnClick="SwitchThemeAsync" />
            <AuthorizeView>
                <Authorized>
                    <FluentAnchorButton Href="/ustawienia-konta" IconStart="@(new Icons.Regular.Size20.Settings())"
                                        Appearance="ButtonAppearance.Transparent" Class="eod-onbrand app-account-settings">
                        Ustawienia konta
                    </FluentAnchorButton>
                    @* A plain form POST with antiforgery (AD-15): only an HTTP response clears the login cookie. *@
                    <form method="post" action="@AccountEndpoints.LogoutPath" class="app-logout">
                        <AntiforgeryToken />
                        <FluentButton Type="ButtonType.Submit" IconStart="@(new Icons.Regular.Size20.SignOut())"
                                      Appearance="ButtonAppearance.Transparent" Class="eod-onbrand">
                            Wyloguj
                        </FluentButton>
                    </form>
                </Authorized>
            </AuthorizeView>
        </HeaderActions>

        <NewCase>
            <AuthorizeView>
                <Authorized>
                    <FluentAnchorButton Href="/wpisy/nowy" Appearance="ButtonAppearance.Primary"
                                        IconStart="@(new Icons.Regular.Size20.Add())" Class="app-new-entry">Nowy wpis</FluentAnchorButton>
                </Authorized>
            </AuthorizeView>
        </NewCase>

        <Menu>
            <AuthorizeView>
                <Authorized>
                    <FluentNavSectionHeader Title="Rejestr" />
                    <FluentNavItem Href="/miesiac" IconRest="@(new Icons.Regular.Size20.CalendarLtr())"
                                   IconActive="@(new Icons.Filled.Size20.CalendarLtr())">Widok miesiąca</FluentNavItem>
                    <FluentNavItem Href="/wpisy" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.TextBulletListLtr())"
                                   IconActive="@(new Icons.Filled.Size20.TextBulletListLtr())">Lista wpisów</FluentNavItem>

                    <FluentNavSectionHeader Title="Słowniki" />
                    <FluentNavItem Href="/projekty" IconRest="@(new Icons.Regular.Size20.Briefcase())"
                                   IconActive="@(new Icons.Filled.Size20.Briefcase())">Projekty</FluentNavItem>
                    <FluentNavItem Href="/typy-pracy" IconRest="@(new Icons.Regular.Size20.Tag())"
                                   IconActive="@(new Icons.Filled.Size20.Tag())">Typy pracy</FluentNavItem>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="@AppRoles.Administrator">
                <FluentNavSectionHeader Title="Administracja" />
                <FluentNavItem Href="/uzytkownicy" IconRest="@(new Icons.Regular.Size20.People())"
                               IconActive="@(new Icons.Filled.Size20.People())">Użytkownicy</FluentNavItem>
            </AuthorizeView>
        </Menu>

        <ChildContent>@Body</ChildContent>
    </EodShell>
</AppErrorBoundary>

<ReconnectModal />

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież stronę</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    /// <summary>The section with the "?" of the top bar, filled by <see cref="PageHelp"/>.</summary>
    public const string HelpSection = "help-topic";

    // Light ↔ dark through AppearanceSettings of the eod-ui copy (it applies the theme and remembers the choice);
    // "system" switches to the opposite of what the system shows now.
    private async Task SwitchThemeAsync()
    {
        var dark = await Appearance.GetThemeAsync() switch
        {
            UiTheme.Dark => true,
            UiTheme.Light => false,
            _ => await ThemeService.IsDarkModeAsync(),
        };
        await Appearance.SetThemeAsync(dark ? UiTheme.Light : UiTheme.Dark);
    }
}
