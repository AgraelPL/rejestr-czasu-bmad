@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@* The header of the screens not yet on EodPage (Projekty, Typy pracy, Nowy wpis, Lista wpisów until stories 7.4 and
   7.5): title, subtitle, breadcrumbs, Odśwież and the help topic for the "?" of the top bar (PageHelp, AD-22). Until
   then it also renders the message section of UiMessages under the header, which EodPage renders for the other screens;
   without it the screen's message bars would not show (UiMessages ignores a missing provider). *@
<PageTitle>@PageTitleText</PageTitle>

<PageHelp Topic="@Topic" />

<header class="page-header">
    @if (Breadcrumbs.Count > 0)
    {
        @* Own breadcrumbs: Fluent UI 5.0.1 has no breadcrumb component. *@
        <nav class="page-breadcrumbs" aria-label="Okruszki">
            <ol>
                @foreach (var crumb in Breadcrumbs)
                {
                    <li><a href="@crumb.Href">@crumb.Text</a></li>
                }
                <li aria-current="page">@Title</li>
            </ol>
        </nav>
    }
    <div class="page-header-row">
        <h1>@Title</h1>
        @if (OnRefresh.HasDelegate)
        {
            <FluentButton IconStart="@(new Icons.Regular.Size20.ArrowClockwise())" OnClick="OnRefresh" class="page-refresh">Odśwież</FluentButton>
        }
    </div>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <p class="page-subtitle">@Subtitle</p>
    }
</header>

<div class="eod-messages page-header-messages" aria-live="polite">
    <FluentMessageBarProvider Section="@EodSections.Page" />
</div>

@code {
    public const string AppName = "Rejestr czasu pracy";

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Links before the current screen, e.g. Pomoc → topic; the current title closes the list.</summary>
    [Parameter] public IReadOnlyList<Breadcrumb> Breadcrumbs { get; set; } = [];

    /// <summary>The Odśwież button is shown only when the screen handles it.</summary>
    [Parameter] public EventCallback OnRefresh { get; set; }

    /// <summary>Help topic key of the screen (AD-22); without it the "?" opens the help index.</summary>
    [Parameter] public string? Topic { get; set; }

    // The same tab title as EodPage of the eod-ui copy (AD-11, AD-23 item 7).
    private string PageTitleText => Title == AppName ? "Rejestr czasu" : $"{Title} · Rejestr czasu";
}
