@page "/konto/zmiana-hasla"
@layout AccountLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowedDuringPasswordChange]
@* The current password must not be guessed without limit: the same limit as login and registration. *@
@attribute [EnableRateLimiting(AccountRateLimit.PolicyName)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.RateLimiting
@inject AccountPassword AccountPassword
@inject NavigationManager Navigation

<PageTitle>Zmiana hasła — Rejestr czasu pracy</PageTitle>
<AccountHelp Topic="zmiana-hasla" />

<h1>Zmiana hasła</h1>

@if (_required)
{
    <AccountMessages Messages="@([RequiredNotice])" Intent="MessageBarIntent.Warning" />
}
else if (Changed == ChangedValue && _errors.Count == 0)
{
    <AccountMessages Messages="@([ChangedMessage])" Intent="MessageBarIntent.Success" />
}

<AccountMessages Messages="@_errors" />

<EditForm Model="Input" FormName="zmiana-hasla" OnValidSubmit="ChangeAsync" method="post" class="account-form">
    <DataAnnotationsValidator />
    @if (!_required)
    {
        <div class="account-field">
            <label for="change-current-password">Obecne hasło</label>
            <InputText id="change-current-password" type="password" @bind-Value="Input.CurrentPassword" autocomplete="current-password" autofocus />
        </div>
    }
    <div class="account-field">
        <label for="change-new-password">Nowe hasło (co najmniej @IdentitySetup.MinPasswordLength znaków)</label>
        <InputText id="change-new-password" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" autofocus="@_required" />
        <ValidationMessage For="() => Input.NewPassword" />
    </div>
    <div class="account-field">
        <label for="change-confirm-password">Powtórz nowe hasło</label>
        <InputText id="change-confirm-password" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" />
    </div>
    <button type="submit" class="account-submit">Zmień hasło</button>
</EditForm>

@if (_required)
{
    @* Logout stays available during a required change (AD-15): POST with antiforgery. *@
    <form method="post" action="@AccountEndpoints.LogoutPath">
        <AntiforgeryToken />
        <button type="submit" class="account-submit">Wyloguj</button>
    </form>
}
else
{
    <p><a href="/">Wróć do aplikacji</a></p>
}

@code {
    public const string RequiredNotice = "Hasło zostało ustawione przez Administratora. Ustaw własne hasło, aby korzystać z aplikacji.";
    public const string ChangedMessage = "Hasło zostało zmienione.";
    public const string ChangedValue = "1";

    private bool _required;
    private IReadOnlyList<string> _errors = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ChangePasswordInput Input { get; set; } = default!;

    /// <summary>Set by the redirect after a voluntary change (POST, redirect, GET), so a refresh does not resend the form.</summary>
    [SupplyParameterFromQuery(Name = "zmieniono")]
    private string? Changed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _required = await AccountPassword.IsChangeRequiredAsync(HttpContext.User);
    }

    private async Task ChangeAsync()
    {
        if (!_required && string.IsNullOrEmpty(Input.CurrentPassword))
        {
            _errors = [AccountPassword.CurrentPasswordRequiredMessage];
            return;
        }

        var result = await AccountPassword.ChangeAsync(HttpContext.User, _required ? null : Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _errors = result.Errors.Select(e => e.Description).ToList();
            return;
        }
        Navigation.NavigateTo(_required ? "/" : $"{AccountEndpoints.ChangePasswordPath}?zmieniono={ChangedValue}");
    }

    private sealed class ChangePasswordInput
    {
        public string? CurrentPassword { get; set; }

        // Password rules come only from the Identity configuration (AD-8); here only required fields.
        [Required(ErrorMessage = "Podaj nowe hasło.")]
        public string NewPassword { get; set; } = "";

        [Compare(nameof(NewPassword), ErrorMessage = "Hasła nie są takie same.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
