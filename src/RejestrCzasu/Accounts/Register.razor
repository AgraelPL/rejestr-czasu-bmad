@page "/konto/rejestracja"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(AccountRateLimit.PolicyName)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.RateLimiting
@inject AccountSignIn AccountSignIn

<PageTitle>Rejestracja — Rejestr czasu pracy</PageTitle>
<AccountHelp Topic="rejestracja" />

<h1>Rejestracja</h1>

@if (_registered)
{
    <AccountMessages Messages="@([RegisteredMessage])" Intent="MessageBarIntent.Success" />
    <p><a href="/konto/logowanie">Przejdź do logowania</a></p>
}
else
{
    <AccountMessages Messages="@_errors" />

    <p class="account-notice">@AdministratorAccessNotice</p>

    <EditForm Model="Input" FormName="rejestracja" OnValidSubmit="RegisterAsync" method="post" class="account-form">
        <DataAnnotationsValidator />
        <div class="account-field">
            <label for="register-user-name">Login</label>
            <InputText id="register-user-name" @bind-Value="Input.UserName" autocomplete="username" maxlength="@IdentitySetup.MaxUserNameLength" autofocus />
            <ValidationMessage For="() => Input.UserName" />
        </div>
        <div class="account-field">
            <label for="register-password">Hasło (co najmniej @IdentitySetup.MinPasswordLength znaków)</label>
            <InputText id="register-password" type="password" @bind-Value="Input.Password" autocomplete="new-password" />
            <ValidationMessage For="() => Input.Password" />
        </div>
        <div class="account-field">
            <label for="register-confirm-password">Powtórz hasło</label>
            <InputText id="register-confirm-password" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>
        <button type="submit" class="account-submit">Załóż Konto</button>
    </EditForm>

    <p>Masz już Konto? <a href="/konto/logowanie">Zaloguj się</a></p>
}

@code {
    public const string AdministratorAccessNotice =
        "Administrator ma przez bazę danych dostęp do wszystkich danych zapisanych w aplikacji, także Twoich.";
    public const string RegisteredMessage =
        "Konto zostało założone i oczekuje na zatwierdzenie przez Administratora. Zalogujesz się po zatwierdzeniu.";

    private bool _registered;
    private IReadOnlyList<string> _errors = [];

    [SupplyParameterFromForm]
    private RegisterInput Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task RegisterAsync()
    {
        var result = await AccountSignIn.RegisterAsync(Input.UserName, Input.Password);
        if (result.Succeeded)
        {
            _registered = true;
            return;
        }
        _errors = result.Errors.Select(e => e.Description).ToList();
    }

    private sealed class RegisterInput
    {
        // Login and password rules come only from the Identity configuration (AD-8); here only required fields.
        [Required(ErrorMessage = "Podaj login.")]
        [StringLength(IdentitySetup.MaxUserNameLength, ErrorMessage = IdentitySetup.UserNameTooLongMessage)]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "Podaj hasło.")]
        public string Password { get; set; } = "";

        [Compare(nameof(Password), ErrorMessage = "Hasła nie są takie same.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
