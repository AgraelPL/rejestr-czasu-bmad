@inject NavigationManager Navigation
@* NotAuthorized for an anonymous visitor in interactive routing (AD-15): full page load of the login page. *@

@code {
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"{AccountEndpoints.LoginPath}?ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
