<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* The eod-ui copy (AD-11, AD-12): Fluent UI styles, reboot, ui/eod.css and the local scripts, once for every page. *@
    <EodHead />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* No RejestrCzasu.styles.css: the application has no CSS isolation (.razor.css), so that bundle only repeated the
       Fluent UI stylesheet after ui/eod.css and undid its rules (e.g. the full width of every EodReport table). With
       the first .razor.css the link comes back before <EodHead />, so the cascade of the pattern stays (AD-11). *@
    @* No <ImportMap />: it renders an inline script blocked by CSP script-src 'self' (AD-12). *@
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Static /konto pages ([ExcludeFromInteractiveRouting]) render without a circuit: only an HTTP response
    // sets the login cookie (AD-15). Every other page is Interactive Server.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
