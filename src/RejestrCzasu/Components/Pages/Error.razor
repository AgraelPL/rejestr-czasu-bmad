@page "/Error"
@using System.Diagnostics
@attribute [AllowAnonymous]
@* Exception handler re-execution must not be redirected during a required password change (AD-15). *@
@attribute [AllowedDuringPasswordChange]

<EodPage Title="Błąd" Description="Podczas przetwarzania żądania wystąpił błąd.">
    @if (ShowRequestId)
    {
        <EodCard>
            <p>
                <strong>Identyfikator żądania:</strong> <code>@RequestId</code>
            </p>
        </EodCard>
    }
</EodPage>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
