@page "/projekty"
@using System.Net
@using RejestrCzasu.Features.Pomoc
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject ProjectStore Store
@inject UiMessages Messages
@inject IDialogService Dialogs
@* Projekty (R1–R3, R17): the User's Project Dictionary on EodPage with EodReport (AD-9, AD-11). Adding and editing
   in ProjectDialog (UI_SPEC 9.13 A), deleting after UiMessages.ConfirmAsync; every change is saved at once. Data only
   through ProjectStore (AD-4, AD-16); after every change the list is read again from the database, then the bar shows. *@

<EodPage Title="Projekty" Description="Kody i nazwy Projektów, które wybierasz we Wpisach." Fill="true">
    <Actions>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="OpenAddAsync"
                      class="projects-add">Dodaj Projekt</FluentButton>
    </Actions>
    <ChildContent>
        <PageHelp Topic="@HelpTopics.Projekty" />
        <EodCard NoPadding="true" Fill="true">
            <EodReport Definition="Report" Rows="_rows" LayoutKey="@HelpTopics.Projekty" ShowExport="false"
                       PreserveRowOrder="true" Loading="_loading">
                <RowActions Context="row">
                    @if (_byId.TryGetValue((int)row[IdKey]!, out var project))
                    {
                        <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())" IconOnly="true" Appearance="ButtonAppearance.Subtle"
                                      Title="Edytuj" aria-label="Edytuj" OnClick="@(() => OpenEditAsync(project))" />
                        @if (project.IsActive)
                        {
                            <FluentButton IconStart="@(new Icons.Regular.Size20.Archive())" IconOnly="true" Appearance="ButtonAppearance.Subtle"
                                          Title="Dezaktywuj" aria-label="Dezaktywuj" OnClick="@(() => SetActiveAsync(project, false))" />
                        }
                        else
                        {
                            <FluentButton IconStart="@(new Icons.Regular.Size20.ArrowUndo())" IconOnly="true" Appearance="ButtonAppearance.Subtle"
                                          Title="Przywróć" aria-label="Przywróć" OnClick="@(() => SetActiveAsync(project, true))" />
                        }
                        <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())" IconOnly="true" Appearance="ButtonAppearance.Subtle"
                                      Title="Usuń" aria-label="Usuń" OnClick="@(() => DeleteAsync(project))" />
                    }
                </RowActions>
            </EodReport>
        </EodCard>
    </ChildContent>
</EodPage>

@code {
    /// <summary>Key of the entity id in a report row, outside the columns; only the row actions use it (AD-9).</summary>
    private const string IdKey = nameof(ProjectRow.Id);

    /// <summary>The report of the screen (AD-9): value filter in every column, counter in the footer, no export.</summary>
    internal static readonly ReportDefinition Report = new()
    {
        Key = HelpTopics.Projekty,
        Title = "Projekty",
        Description = "Kody i nazwy Projektów, które wybierasz we Wpisach.",
        FileName = HelpTopics.Projekty,
        Columns =
        [
            new(nameof(ProjectRow.Code), "Kod", ColumnType.List) { IsKey = true },
            new(nameof(ProjectRow.Name), "Nazwa", ColumnType.List),
            new(nameof(ProjectRow.State), "Stan", ColumnType.List),
        ],
    };

    private IReadOnlyList<IReadOnlyDictionary<string, object?>> _rows = [];
    private IReadOnlyDictionary<int, ProjectRow> _byId = new Dictionary<int, ProjectRow>();
    private bool _loading = true;
    private bool _busy;

    /// <summary>The report row of a Project: the columns plus <c>Id</c> for the row actions (AD-9).</summary>
    internal static IReadOnlyDictionary<string, object?> ToRow(ProjectRow project) => new Dictionary<string, object?>
    {
        [IdKey] = project.Id,
        [nameof(ProjectRow.Code)] = project.Code,
        [nameof(ProjectRow.Name)] = project.Name,
        [nameof(ProjectRow.State)] = project.State,
    };

    /// <summary>Warning shown when a Project used by Entries is to be deleted (R3).</summary>
    internal static string InUseMessage(string code, int entryCount) =>
        $"Projekt {code} występuje w {EntryCount.InEntries(entryCount)}. Zamiast go usuwać, dezaktywuj go.";

    internal static string DuplicateMessage(string code) => $"Projekt o kodzie {code} już istnieje.";

    internal const string NotFoundMessage = "Ten Projekt już nie istnieje. Lista została wczytana ponownie.";

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        var projects = await Store.ListAsync();
        _byId = projects.ToDictionary(p => p.Id);
        _rows = projects.Select(ToRow).ToList();
    }

    private Task OpenAddAsync() => RunDialogAsync(new ProjectForm(), null);

    private Task OpenEditAsync(ProjectRow row) =>
        RunDialogAsync(new ProjectForm { Id = row.Id, Code = row.Code, Name = row.Name }, row.Code);

    private async Task RunDialogAsync(ProjectForm form, string? editedCode)
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        try
        {
            var result = await ProjectDialog.ShowAsync(Dialogs, form, editedCode);
            if (result.Cancelled)
            {
                return;
            }
            var change = result.GetValue<ProjectChange>();
            await ReloadAsync();
            if (change is ProjectChange.Done done)
            {
                await Messages.ShowSuccessAsync(form.Id is null ? $"Dodano Projekt {done.Code}." : $"Zapisano Projekt {done.Code}.");
            }
            else
            {
                await Messages.ShowWarningAsync(NotFoundMessage);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetActiveAsync(ProjectRow row, bool isActive)
    {
        var change = await Store.SetActiveAsync(row.Id, isActive);
        await ReloadAsync();
        if (change is ProjectChange.Done done)
        {
            await Messages.ShowSuccessAsync(isActive ? $"Przywrócono Projekt {done.Code}." : $"Dezaktywowano Projekt {done.Code}.");
        }
        else
        {
            await Messages.ShowWarningAsync(NotFoundMessage);
        }
    }

    private async Task DeleteAsync(ProjectRow row)
    {
        if (!await Messages.ConfirmAsync("Usunąć Projekt?", $"<p>Usunąć Projekt <strong>{WebUtility.HtmlEncode(row.Code)}</strong> ({WebUtility.HtmlEncode(row.Name)})?</p>", "Usuń"))
        {
            return;
        }
        var change = await Store.DeleteAsync(row.Id);
        await ReloadAsync();
        switch (change)
        {
            case ProjectChange.Done done:
                await Messages.ShowSuccessAsync($"Usunięto Projekt {done.Code}.");
                break;
            case ProjectChange.InUse inUse:
                await Messages.ShowWarningAsync(InUseMessage(inUse.Code, inUse.EntryCount));
                break;
            default:
                await Messages.ShowWarningAsync(NotFoundMessage);
                break;
        }
    }
}
