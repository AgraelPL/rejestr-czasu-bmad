@using System.Security.Claims
@* One help topic for one User (AD-22): its content, the login page for an anonymous visitor of a non-public topic,
   or the same "no access" view as /konto/brak-dostepu. *@
@switch (HelpTopics.Decide(Topic, User))
{
    case HelpDecision.Allowed:
        @if (Topic.Access == HelpAccess.Anonymous)
        {
            <AccountHelp Topic="@Topic.Key" />
        }
        <EodPage Title="@Topic.Title" Breadcrumb="@Crumbs(Topic)">
            <PageHelp Topic="@Topic.Key" />
            <EodCard>
                <div class="help-content">
                    <DynamicComponent Type="@Topic.Content" />
                </div>
            </EodCard>
        </EodPage>
        break;
    case HelpDecision.LoginRequired:
        <RedirectToLogin />
        break;
    default:
        <PageTitle>Brak dostępu · Rejestr czasu</PageTitle>
        <AccessDeniedContent />
        break;
}

@code {
    // Pomoc › the topic (the current page, without an address).
    private static IReadOnlyList<BreadcrumbItem> Crumbs(HelpTopic topic) => [new("Pomoc", HelpButton.HrefOf(null)), new(topic.Title)];

    [Parameter, EditorRequired] public HelpTopic Topic { get; set; } = default!;

    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;
}
