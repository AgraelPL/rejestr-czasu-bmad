@page "/typy-pracy"
@using System.Net
@using RejestrCzasu.Features.Pomoc
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject WorkTypeStore Store
@inject UiMessages Messages
@inject IDialogService Dialogs
@* Typy pracy (R1–R3, R17): the User's Work type Dictionary, the same pattern as Projekty: EodPage with EodReport
   (AD-9, AD-11), adding and editing in WorkTypeDialog (UI_SPEC 9.13 A), deleting after UiMessages.ConfirmAsync; every
   change is saved at once. Data only through WorkTypeStore (AD-4, AD-16); after every change the list is read again
   from the database, then the bar shows. *@

<EodPage Title="Typy pracy" Description="Nazwy Typów pracy, które wybierasz we Wpisach." Fill="true">
    <Actions>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="OpenAddAsync"
                      class="work-types-add">Dodaj Typ pracy</FluentButton>
    </Actions>
    <ChildContent>
        <PageHelp Topic="@HelpTopics.TypyPracy" />
        <EodCard NoPadding="true" Fill="true">
            <EodReport Definition="Report" Rows="_rows" LayoutKey="@HelpTopics.TypyPracy" ShowExport="false"
                       PreserveRowOrder="true" Loading="_loading">
                <RowActions Context="row">
                    @if (_byId.TryGetValue((int)row[IdKey]!, out var workType))
                    {
                        <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())" IconOnly="true" Appearance="ButtonAppearance.Subtle"
                                      Title="Edytuj" aria-label="Edytuj" OnClick="@(() => OpenEditAsync(workType))" />
                        @if (workType.IsActive)
                        {
                            <FluentButton IconStart="@(new Icons.Regular.Size20.Archive())" IconOnly="true" Appearance="ButtonAppearance.Subtle"
                                          Title="Dezaktywuj" aria-label="Dezaktywuj" OnClick="@(() => SetActiveAsync(workType, false))" />
                        }
                        else
                        {
                            <FluentButton IconStart="@(new Icons.Regular.Size20.ArrowUndo())" IconOnly="true" Appearance="ButtonAppearance.Subtle"
                                          Title="Przywróć" aria-label="Przywróć" OnClick="@(() => SetActiveAsync(workType, true))" />
                        }
                        <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())" IconOnly="true" Appearance="ButtonAppearance.Subtle"
                                      Title="Usuń" aria-label="Usuń" OnClick="@(() => DeleteAsync(workType))" />
                    }
                </RowActions>
            </EodReport>
        </EodCard>
    </ChildContent>
</EodPage>

@code {
    /// <summary>Key of the entity id in a report row, outside the columns; only the row actions use it (AD-9).</summary>
    private const string IdKey = nameof(WorkTypeRow.Id);

    /// <summary>The report of the screen (AD-9): value filter in every column, counter in the footer, no export.</summary>
    internal static readonly ReportDefinition Report = new()
    {
        Key = HelpTopics.TypyPracy,
        Title = "Typy pracy",
        Description = "Nazwy Typów pracy, które wybierasz we Wpisach.",
        FileName = HelpTopics.TypyPracy,
        Columns =
        [
            new(nameof(WorkTypeRow.Name), "Nazwa", ColumnType.List) { IsKey = true },
            new(nameof(WorkTypeRow.State), "Stan", ColumnType.List),
        ],
    };

    private IReadOnlyList<IReadOnlyDictionary<string, object?>> _rows = [];
    private IReadOnlyDictionary<int, WorkTypeRow> _byId = new Dictionary<int, WorkTypeRow>();
    private bool _loading = true;
    private bool _busy;

    /// <summary>The report row of a Work type: the columns plus <c>Id</c> for the row actions (AD-9).</summary>
    internal static IReadOnlyDictionary<string, object?> ToRow(WorkTypeRow workType) => new Dictionary<string, object?>
    {
        [IdKey] = workType.Id,
        [nameof(WorkTypeRow.Name)] = workType.Name,
        [nameof(WorkTypeRow.State)] = workType.State,
    };

    /// <summary>Warning shown when a Work type used by Entries is to be deleted (R3).</summary>
    internal static string InUseMessage(string name, int entryCount) =>
        $"Typ pracy {name} występuje w {EntryCount.InEntries(entryCount)}. Zamiast go usuwać, dezaktywuj go.";

    internal static string DuplicateMessage(string name) => $"Typ pracy o nazwie {name} już istnieje.";

    internal const string NotFoundMessage = "Ten Typ pracy już nie istnieje. Lista została wczytana ponownie.";

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        var workTypes = await Store.ListAsync();
        _byId = workTypes.ToDictionary(w => w.Id);
        _rows = workTypes.Select(ToRow).ToList();
    }

    private Task OpenAddAsync() => RunDialogAsync(new WorkTypeForm(), null);

    private Task OpenEditAsync(WorkTypeRow row) =>
        RunDialogAsync(new WorkTypeForm { Id = row.Id, Name = row.Name }, row.Name);

    private async Task RunDialogAsync(WorkTypeForm form, string? editedName)
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        try
        {
            var result = await WorkTypeDialog.ShowAsync(Dialogs, form, editedName);
            if (result.Cancelled)
            {
                return;
            }
            var change = result.GetValue<WorkTypeChange>();
            await ReloadAsync();
            if (change is WorkTypeChange.Done done)
            {
                await Messages.ShowSuccessAsync(form.Id is null ? $"Dodano Typ pracy {done.Name}." : $"Zapisano Typ pracy {done.Name}.");
            }
            else
            {
                await Messages.ShowWarningAsync(NotFoundMessage);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetActiveAsync(WorkTypeRow row, bool isActive)
    {
        var change = await Store.SetActiveAsync(row.Id, isActive);
        await ReloadAsync();
        if (change is WorkTypeChange.Done done)
        {
            await Messages.ShowSuccessAsync(isActive ? $"Przywrócono Typ pracy {done.Name}." : $"Dezaktywowano Typ pracy {done.Name}.");
        }
        else
        {
            await Messages.ShowWarningAsync(NotFoundMessage);
        }
    }

    private async Task DeleteAsync(WorkTypeRow row)
    {
        if (!await Messages.ConfirmAsync("Usunąć Typ pracy?", $"<p>Usunąć Typ pracy <strong>{WebUtility.HtmlEncode(row.Name)}</strong>?</p>", "Usuń"))
        {
            return;
        }
        var change = await Store.DeleteAsync(row.Id);
        await ReloadAsync();
        switch (change)
        {
            case WorkTypeChange.Done done:
                await Messages.ShowSuccessAsync($"Usunięto Typ pracy {done.Name}.");
                break;
            case WorkTypeChange.InUse inUse:
                await Messages.ShowWarningAsync(InUseMessage(inUse.Name, inUse.EntryCount));
                break;
            default:
                await Messages.ShowWarningAsync(NotFoundMessage);
                break;
        }
    }
}
