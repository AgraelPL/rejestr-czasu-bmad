@page "/wpisy/nowy"
@using RejestrCzasu.Data
@using RejestrCzasu.Domain
@using RejestrCzasu.Features.Pomoc
@inject EntryStore Store
@inject DictionaryOptions Options
@inject EntryDateMemory DateMemory
@inject CurrentUser CurrentUser
@inject TimeProvider TimeProvider
@inject UiMessages Messages
@* Nowy wpis (R4, R5, R16): the Sesja wpisywania. Every opening starts with today's date in Poland; after a save the
   form stays with the same date and the focus goes to Projekt. The date set here is remembered for the copy of an
   Entry (EntryDateMemory, R7). Under the form the Entries of the current Month in Poland (EntriesReport, AD-9), read
   again after every save and every row action; the Month is taken at every load, so a save after midnight on the
   last day shows the new Month. Data only through EntryStore and DictionaryOptions (AD-4, AD-16). The page focuses
   Data itself after the form's first render: FocusOnNavigate (h1) has already focused the page when the form appears
   after the options load, so the autofocus of the field would be blocked. *@

<EodPage Title="Nowy wpis" Description="Kolejne Wpisy samą klawiaturą: data, Projekt, Typ pracy, opis, Czas i Enter." Fill="true">
    <PageHelp Topic="@HelpTopics.WpisyNowy" />
    <EodCard>
        @if (_projects is not null && _workTypes is not null)
        {
            <EntryForm @ref="_form" Model="_input" Projects="_projects" WorkTypes="_workTypes" OnSave="SaveAsync"
                       OnDateChanged="RememberDate" AutofocusDate="false" />
        }
    </EodCard>
    <EodCard NoPadding="true" Fill="true">
        <EntriesReport Definition="EntriesReport.CurrentMonth" Entries="_month" LayoutKey="@HelpTopics.WpisyNowy" OnChanged="ReloadMonthAsync" />
    </EodCard>
</EodPage>

@code {
    private EntryForm? _form;
    private EntryInput _input = new();
    private IReadOnlyList<ProjectOption>? _projects;
    private IReadOnlyList<WorkTypeOption>? _workTypes;
    private int _userId;
    // The Entries of the current Month (source of the footer sum, AD-5); null until the first load.
    private IReadOnlyList<EntryRow>? _month;
    // Every reload takes the next version; an older query finishing later never overwrites a newer result.
    private int _version;
    private bool _dateFocused;

    protected override async Task OnInitializedAsync()
    {
        var today = PolishCalendar.Today(TimeProvider);
        _input = new EntryInput { Date = today };
        _userId = await CurrentUser.GetUserIdAsync();
        DateMemory.Remember(_userId, today);
        await LoadOptionsAsync();
        // The form first (and the focus in Data), then the list of the Month.
        StateHasChanged();
        await ReloadMonthAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Once, after the first render with the form (the options are loaded asynchronously before it).
        if (_dateFocused || _form is null)
        {
            return;
        }
        _dateFocused = true;
        await _form.FocusDateAsync();
    }

    private async Task ReloadMonthAsync()
    {
        var version = ++_version;
        var month = YearMonth.From(PolishCalendar.Today(TimeProvider));
        var entries = await Store.ListAsync(new EntryFilter(month.FirstDay, month.LastDay, null, null));
        if (version == _version)
        {
            _month = entries;
        }
    }

    private async Task ReloadMonthAfterSaveAsync()
    {
        try
        {
            await ReloadMonthAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            // The same error handling as an awaited failure of the page (AppErrorBoundary).
            await DispatchExceptionAsync(exception);
        }
    }

    private async Task LoadOptionsAsync()
    {
        _projects = await Options.ProjectsAsync(null, CancellationToken.None);
        _workTypes = await Options.WorkTypesAsync(null, CancellationToken.None);
    }

    private void RememberDate(DateOnly? date)
    {
        if (date is { } value)
        {
            DateMemory.Remember(_userId, value);
        }
    }

    private async Task SaveAsync(EntryInput input)
    {
        var change = await Store.AddAsync(input.Date!.Value, input.Project!.Id, input.WorkType!.Id, input.Description, input.Czas);
        switch (change)
        {
            case EntryChange.Done done:
                var message = EntryMessages.Saved(input.Date.Value, input.Project.Code, done.Minutes);
                input.ClearAfterSave();
                if (_form is not null)
                {
                    await _form.FocusProjectAsync();
                }
                await Messages.ShowSuccessAsync(message);
                // Not awaited: the form's save lock ends now, so the next Enter of the Sesja is not held by the list.
                _ = ReloadMonthAfterSaveAsync();
                break;
            case EntryChange.MissingDictionaryItem:
                // The form keeps the typed values; the lists no longer offer the missing item.
                await Messages.ShowErrorAsync(EntryMessages.MissingDictionaryItem);
                await LoadOptionsAsync();
                break;
        }
    }
}
