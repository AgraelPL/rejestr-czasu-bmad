@using RejestrCzasu.Domain
@using RejestrCzasu.Features.Pomoc
@inject TimeProvider TimeProvider
@* The report of Entries (AD-9): the one definition, row and footer of the Lista wpisów (/wpisy, the screen filters'
   list) and of the list of the current Month under the form on Nowy wpis (/wpisy/nowy). The host loads the list
   through EntryStore and gives it here; the footer sum comes from that list (AD-5), so the report's column filters only
   hide rows. The row icons edit, copy and delete the Entry through EntryDialogs by its Id (R6, R7, AD-10); after a
   change the host reads the list again (OnChanged, given to EntryDialogs as afterChange), and only then EntryDialogs
   shows the bar, on Lista wpisów and on Nowy wpis alike. Eksportuj writes every row that passes the screen filters, the
   column filters and the search, from all pages (30 rows a page), to xlsx (EntriesXlsx): Data a date cell, Czas the
   column "Godziny" as a number of decimal hours. *@

<EodReport Definition="Definition" Rows="_rows" LayoutKey="@LayoutKey" PageSize="PageSize" ExportFile="EntriesXlsx.Write"
           DataAsOf="PolishCalendar.Today(TimeProvider)" PreserveRowOrder="true" Loading="Entries is null" FooterSummary="@Summary(Entries ?? [])">
    <RowActions Context="row">
        @{ var id = (int)row[IdKey]!; }
        <EntryRowActions Id="id" Gate="_gate" AfterChange="() => OnChanged.InvokeAsync()" />
    </RowActions>
</EodReport>

@code {
    /// <summary>Key of the Entry id in a report row, outside the columns; only the row actions use it (AD-9).</summary>
    private const string IdKey = nameof(EntryRow.Id);

    /// <summary>Rows on one page of the report; the footer and the export count all rows after the filters (AD-5).</summary>
    internal const int PageSize = 30;

    /// <summary>
    /// The report of Entries (AD-9): value filter in every column, counter in the footer, export to xlsx. Data is a
    /// <see cref="DateOnly"/> and Czas an <see cref="int"/> of minutes, so both sort by value, not by text. In the file
    /// (<see cref="EntriesXlsx"/>) Data is a date cell dd.mm.yyyy and Czas the column "Godziny" in decimal hours as a
    /// number (1.5), as in the Zestawienie.
    /// </summary>
    internal static readonly ReportDefinition Report = new()
    {
        Key = HelpTopics.Wpisy,
        Title = "Lista wpisów",
        Description = "Twoje Wpisy z zakresu dat, Projektu i Typu pracy, od najnowszych.",
        FileName = HelpTopics.Wpisy,
        Columns =
        [
            new(nameof(EntryRow.Date), "Data", ColumnType.List) {
                IsKey = true,
                Format = v => EntryMessages.Date((DateOnly)v!),
            },
            new(nameof(EntryRow.DayName), "Dzień", ColumnType.List),
            new(nameof(EntryRow.ProjectCode), "Projekt", ColumnType.List),
            new(nameof(EntryRow.WorkTypeName), "Typ pracy", ColumnType.List),
            new(nameof(EntryRow.Description), "Opis", ColumnType.List) { FillWidth = true },
            new(nameof(EntryRow.Minutes), "Czas", ColumnType.List)
            {
                Format = v => Czas.Format((int)v!),
                ExportLabel = "Godziny",
            },
        ],
    };

    /// <summary>
    /// The report of the current Month under the form on Nowy wpis: the same columns as <see cref="Report"/>, its own
    /// title (the table's <c>aria-label</c>) and key; the export file is named like the one of Lista wpisów.
    /// </summary>
    internal static readonly ReportDefinition CurrentMonth = Report with
    {
        Key = HelpTopics.WpisyNowy,
        Title = "Wpisy bieżącego Miesiąca",
        Description = "Twoje Wpisy z bieżącego Miesiąca, od najnowszych.",
        FileName = HelpTopics.Wpisy,
    };

    private IReadOnlyList<EntryRow>? _shown;
    private IReadOnlyList<IReadOnlyDictionary<string, object?>> _rows = [];
    private readonly SingleAction _gate = new();

    /// <summary>The Entries from <c>EntryStore.ListAsync</c>, in its order; <c>null</c> until the first load (skeleton rows).</summary>
    [Parameter] public IReadOnlyList<EntryRow>? Entries { get; set; }

    /// <summary>The report definition: <see cref="Report"/> (Lista wpisów, default) or <see cref="CurrentMonth"/> (Nowy wpis).</summary>
    [Parameter] public ReportDefinition Definition { get; set; } = Report;

    /// <summary>The key of the User's layout (AD-9): the help topic of the host screen.</summary>
    [Parameter, EditorRequired] public string LayoutKey { get; set; } = "";

    /// <summary>Called after a row action that changed the data or found the Entry missing, before <see cref="EntryDialogs"/> shows its bar.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>The report row of an Entry: the columns plus <c>Id</c> for the row actions (AD-9).</summary>
    internal static IReadOnlyDictionary<string, object?> ToRow(EntryRow entry) => new Dictionary<string, object?>
    {
        [IdKey] = entry.Id,
        [nameof(EntryRow.Date)] = entry.Date,
        [nameof(EntryRow.DayName)] = entry.DayName,
        [nameof(EntryRow.ProjectCode)] = entry.ProjectCode,
        [nameof(EntryRow.WorkTypeName)] = entry.WorkTypeName,
        [nameof(EntryRow.Description)] = entry.Description,
        [nameof(EntryRow.Minutes)] = entry.Minutes,
    };

    /// <summary>The text of the footer after the report's counter: count and sum of Czas of the host's list.</summary>
    internal static string Summary(IReadOnlyList<EntryRow> rows) =>
        $"Wpisy: {rows.Count}, suma Czasu: {Czas.Format(rows.Sum(r => r.Minutes))}";

    protected override void OnParametersSet()
    {
        // The rows are built again only for a new list from the host.
        if (!ReferenceEquals(_shown, Entries))
        {
            _shown = Entries;
            _rows = Entries?.Select(ToRow).ToList() ?? [];
        }
    }
}
