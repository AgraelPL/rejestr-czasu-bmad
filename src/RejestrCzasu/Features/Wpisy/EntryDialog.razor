@using RejestrCzasu.Data
@inject EntryStore Store
@inject DictionaryOptions Options
@* The Entry window (R6, R7, AD-10): the one EntryForm in a modal window of EntryDialogs, for the edit (EntryId set)
   and the copy (EntryId null) of an Entry. The window saves through EntryStore itself and closes only after Done or
   NotFound, with the EntryChange as the result: EntryDialogs shows the page bar after the window has closed (the
   page's bars lie under the modal). A missing Dictionary item keeps the window open with the typed values and the
   error in its own content; a submit that fails validation clears that error. Zapisz first, Anuluj next to it;
   Anuluj and Escape close the window without saving. *@
<FluentDialogBody>
    <ChildContent>
        @if (_error is not null)
        {
            @* AD-10: a save error is shown in the window, the page's message bars lie under the modal. *@
            <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false" role="alert" class="entry-dialog-error">@_error</FluentMessageBar>
        }
        <EntryForm Model="Model" Projects="_projects" WorkTypes="_workTypes" OnSave="SaveAsync" OnInvalid="ClearError">
            <Buttons>
                <FluentButton OnClick="CancelAsync" class="entry-dialog-cancel">Anuluj</FluentButton>
            </Buttons>
        </EntryForm>
    </ChildContent>
</FluentDialogBody>

@code {
    private IReadOnlyList<ProjectOption> _projects = [];
    private IReadOnlyList<WorkTypeOption> _workTypes = [];
    private string? _error;

    /// <summary>The window instance cascaded by the library's dialog provider.</summary>
    [CascadingParameter] public required IDialogInstance Dialog { get; set; }

    /// <summary>The values shown when the window opens.</summary>
    [Parameter, EditorRequired] public EntryInput Model { get; set; } = default!;

    [Parameter, EditorRequired] public IReadOnlyList<ProjectOption> Projects { get; set; } = [];

    [Parameter, EditorRequired] public IReadOnlyList<WorkTypeOption> WorkTypes { get; set; } = [];

    /// <summary>The edited Entry; <c>null</c> for a copy, which is saved as a new Entry.</summary>
    [Parameter] public int? EntryId { get; set; }

    /// <summary>The Project id passed to <c>DictionaryOptions</c> when the options are loaded again (edit: the Entry's).</summary>
    [Parameter] public int? CurrentProjectId { get; set; }

    /// <summary>The Work type id passed to <c>DictionaryOptions</c> when the options are loaded again.</summary>
    [Parameter] public int? CurrentWorkTypeId { get; set; }

    protected override void OnInitialized()
    {
        _projects = Projects;
        _workTypes = WorkTypes;
    }

    private async Task SaveAsync(EntryInput input)
    {
        _error = null;
        var date = input.Date!.Value;
        var projectId = input.Project!.Id;
        var workTypeId = input.WorkType!.Id;
        var change = EntryId is { } id
            ? await Store.UpdateAsync(id, date, projectId, workTypeId, input.Description, input.Czas)
            : await Store.AddAsync(date, projectId, workTypeId, input.Description, input.Czas);
        switch (change)
        {
            case EntryChange.Done or EntryChange.NotFound:
                await Dialog.CloseAsync(change);
                break;
            case EntryChange.MissingDictionaryItem:
                // The window stays open with the typed values; the lists no longer offer the missing item.
                _error = EntryMessages.MissingDictionaryItem;
                _projects = await Options.ProjectsAsync(CurrentProjectId, CancellationToken.None);
                _workTypes = await Options.WorkTypesAsync(CurrentWorkTypeId, CancellationToken.None);
                break;
        }
    }

    // A submit that fails validation shows the field messages only; an earlier save error no longer applies.
    private void ClearError() => _error = null;

    private Task CancelAsync() => Dialog.CancelAsync();
}
